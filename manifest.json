{
  "schemaVersion": 1,
  "id": "kokd.daylight",
  "name": "Daylight",
  "version": "0.1.0",
  "author": "Kostadin Kadiev",
  "license": "MIT",
  "description": "Brightness that follows the sun, on any machine. A solar-elevation schedule works with no hardware at all; an ambient light sensor refines it where one exists.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Daylight",
    "description": "Brightness that follows the sun, on any machine.",
    "category": "System",
    "aliases": [
      "brightness",
      "adaptive",
      "auto-brightness",
      "backlight",
      "ambient",
      "als",
      "flux",
      "night",
      "sun",
      "daylight",
      "dim"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "automatic": true,
      "dayBrightness": 85,
      "nightBrightness": 25,
      "offsetPercent": 0
    }
  }
}
